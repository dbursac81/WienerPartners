@page "/create-policy/{PartnerId:int}"
@inherits CreatePolicyBase

<Shared.NavMenu />

<h4>Unos nove police za partnera @PartnerId</h4>

<EditForm Model="Model" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="form-group">
        <label>Broj police</label>
        <InputText class="form-control" @bind-Value="Model.PolicyNumber" />
    </div>
    <div class="form-group">
        <label>Iznos police</label>
        <InputNumber class="form-control" @bind-Value="Model.PolicyAmount" />
    </div>

    <button class="btn btn-primary" type="submit">Spremi policu</button>
</EditForm>
