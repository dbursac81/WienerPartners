@page "/create-policy/{PartnerId:int}"
@inherits CreatePolicyBase

<Shared.NavMenu />

<h4>New policy for partner @FullName</h4>

<EditForm Model="Model" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="form-group">
        <label>Policy number</label>
        <InputText class="form-control" @bind-Value="Model.PolicyNumber" />
    </div>
    <div class="form-group">
        <label>Policy amount</label>
        <InputNumber class="form-control" @bind-Value="Model.PolicyAmount" />
    </div>

    <div class="form-group mt-3 text-right">
        <button style="margin-top:10px" class="btn btn-primary" type="submit">Save</button>
        <button style="margin-top:10px" class="btn btn-secondary ml-2" @onclick="Cancel">Cancel</button>
    </div>
</EditForm>
