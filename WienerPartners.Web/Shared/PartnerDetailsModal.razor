@using WienerPartners.Core.Models
@inherits PartnerDetailsModalBase

<div class="modal fade @(Show ? "show d-block" : "")" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header d-flex justify-content-between align-items-center">
                <h5 class="modal-title">Partner details</h5>               
            </div>
            <div class="modal-body">
                @if (Partner is not null)
                {
                    <table class="table table-sm">
                        <tbody>
                            <tr><th>Full name:</th><td>@Partner.FullName</td></tr>
                            <tr><th>Address:</th><td>@Partner.Address</td></tr>
                            <tr><th>Partner number;</th><td>@Partner.PartnerNumber</td></tr>
                            <tr><th>OIB:</th><td>@Partner.CroatianPIN</td></tr>
                            <tr><th>Partner type:</th><td>@(Partner.PartnerTypeId == 1 ? "Personal" : "Legal")</td></tr>
                            <tr><th>Created by:</th><td>@Partner.CreateByUser</td></tr>
                            <tr><th>Created at:</th><td>@Partner.CreatedAtUtc.ToLocalTime()</td></tr>
                            <tr><th>Is foreign:</th><td>@(Partner.IsForeign ? "Yes" : "No")</td></tr>
                            <tr><th>External code:</th><td>@Partner.ExternalCode</td></tr>
                            <tr><th>Gender:</th><td>@Partner.Gender</td></tr>
                            <tr><th>Number of policies:</th><td>@Partner.PoliciesCount</td></tr>
                            <tr><th>Total policy value:</th><td>@Partner.PoliciesSum EUR</td></tr>
                        </tbody>
                    </table>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="OnCloseClicked">Close</button>
            </div>
        </div>
    </div>
</div>
